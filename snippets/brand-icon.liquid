{%- doc -%}
  Line icons for the custom sections: 24px grid, 1.5px stroke (--stroke-md), round caps,
  drawn in currentColor so they follow the text colour.

  @param {string} name - search, account, heart, bag, menu, close, chevron-down, chevron-right, arrow-right,
    truck, gift, returns, book, star
  @param {number} [size] - Rendered size in px. Defaults to 22.

  @example
  {% render 'brand-icon', name: 'bag', size: 22 %}
{%- enddoc -%}

{%- assign size = size | default: 22 -%}

<svg
  class="brand-icon brand-icon--{{ name }}"
  width="{{ size }}"
  height="{{ size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.25"/><path d="m15.75 15.75 4 4"/>
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="3.75"/><path d="M4.75 19.75c.9-3.5 3.8-5.5 7.25-5.5s6.35 2 7.25 5.5"/>
    {%- when 'heart' -%}
      <path d="M12 19.25s-7.25-4.3-7.25-9.6A3.9 3.9 0 0 1 8.65 5.75c1.45 0 2.65.75 3.35 1.95.7-1.2 1.9-1.95 3.35-1.95a3.9 3.9 0 0 1 3.9 3.9c0 5.3-7.25 9.6-7.25 9.6Z"/>
    {%- when 'bag' -%}
      <path d="M5.75 8.25h12.5l-.85 10.6a1.5 1.5 0 0 1-1.5 1.4h-7.8a1.5 1.5 0 0 1-1.5-1.4l-.85-10.6Z"/><path d="M9 10.25V7a3 3 0 0 1 6 0v3.25"/>
    {%- when 'menu' -%}
      <path d="M4.75 7.25h14.5M4.75 12h14.5M4.75 16.75h14.5"/>
    {%- when 'close' -%}
      <path d="m6.75 6.75 10.5 10.5M17.25 6.75l-10.5 10.5"/>
    {%- when 'chevron-down' -%}
      <path d="m7.75 10 4.25 4.25L16.25 10"/>
    {%- when 'chevron-right' -%}
      <path d="m10 7.75 4.25 4.25L10 16.25"/>
    {%- when 'arrow-right' -%}
      <path d="M5.75 12h12.5M13.5 7.25 18.25 12l-4.75 4.75"/>
    {%- when 'truck' -%}
      <path d="M2.75 6.75h10.5v9.5H2.75zM13.25 9.75h4l3 3.25v3.25h-7"/><circle cx="6.75" cy="17.25" r="1.75"/><circle cx="16.75" cy="17.25" r="1.75"/>
    {%- when 'gift' -%}
      <path d="M4.75 9.25h14.5v3H4.75zM5.75 12.25h12.5v7.5H5.75zM12 9.25v10.5"/><path d="M12 9.25S10.9 5.25 8.6 5.25a1.75 1.75 0 0 0 0 3.5M12 9.25s1.1-4 3.4-4a1.75 1.75 0 0 1 0 3.5"/>
    {%- when 'returns' -%}
      <path d="M4.75 9h13.5M14.75 5.5 18.25 9l-3.5 3.5M19.25 15H5.75M9.25 11.5 5.75 15l3.5 3.5"/>
    {%- when 'book' -%}
      <path d="M12 6.75c-1.6-1.3-4-2-7.25-2v13c3.25 0 5.65.7 7.25 2 1.6-1.3 4-2 7.25-2v-13c-3.25 0-5.65.7-7.25 2ZM12 6.75v13"/>
    {%- when 'star' -%}
      <path d="m12 4.75 2.2 4.6 5.05.65-3.7 3.5.95 5-4.5-2.45-4.5 2.45.95-5-3.7-3.5 5.05-.65z"/>
  {%- endcase -%}
</svg>
