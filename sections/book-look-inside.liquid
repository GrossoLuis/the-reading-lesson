{%- comment -%}
  Look inside: sample pages from the product's custom.look_inside metafield (a list of
  images, in reading order).

  The heading like the homepage sections, with round arrows that move the row of pages.
  The pages are the protagonists: big, on white with the book shadow, numbered, and a
  "zoom" chip on hover. Any page opens the full-screen viewer at that page: arrows,
  keyboard, swipe on phones, a counter and thumbnails. Behaviour lives in
  assets/book-look-inside.js.

  Hidden when the product has no sample pages; in the theme editor it shows a note.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign pages = product.metafields.custom.look_inside.value
  assign page_count = pages.size
-%}

{%- if page_count > 0 -%}
  <script
    type="module"
    src="{{ 'book-look-inside.js' | asset_url }}"
  ></script>

  <book-look-inside class="look-inside surface-{{ s.surface }}">
    <div class="look-inside__container">
      <header class="look-inside__header">
        <div class="look-inside__intro">
          {%- if s.eyebrow != blank -%}
            <p class="look-inside__eyebrow text-eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="look-inside__heading text-display">{{ s.heading }}</h2>
          {%- endif -%}
          {%- if s.text != blank -%}
            <p class="look-inside__text">{{ s.text }}</p>
          {%- endif -%}
        </div>

        {%- if page_count > 1 -%}
          <div class="look-inside__arrows">
            <button
              type="button"
              class="look-inside__arrow"
              data-track-step="-1"
              aria-label="Previous pages"
              disabled
            >
              {% render 'brand-icon', name: 'arrow-left', size: 20 %}
            </button>
            <button
              type="button"
              class="look-inside__arrow"
              data-track-step="1"
              aria-label="Next pages"
            >
              {% render 'brand-icon', name: 'arrow-right', size: 20 %}
            </button>
          </div>
        {%- endif -%}
      </header>

      <ul
        class="look-inside__track"
        role="list"
        data-track
      >
        {%- for page in pages -%}
          {%- liquid
            assign image = page.preview_image | default: page
            assign alt = page.alt | default: image.alt
            if alt == blank
              assign alt = product.title | append: ', sample page ' | append: forloop.index
            endif
          -%}
          <li
            class="look-inside__item"
            data-track-item
          >
            <button
              type="button"
              class="look-inside__page"
              data-viewer-open
              data-index="{{ forloop.index0 }}"
              aria-label="Open page {{ forloop.index }} of {{ page_count }} full screen"
              style="--ratio: {{ image.aspect_ratio | default: 0.75 }};"
            >
              {{-
                image
                | image_url: width: 1200
                | image_tag:
                  class: 'look-inside__image',
                  widths: '400, 600, 800, 1000, 1200',
                  sizes: '(min-width: 990px) 420px, 70vw',
                  loading: 'lazy',
                  alt: alt
              -}}
              <span
                class="look-inside__zoom"
                aria-hidden="true"
              >
                {%- render 'brand-icon', name: 'expand', size: 16 -%}
                Zoom
              </span>
            </button>
            <p class="look-inside__number text-eyebrow">Page {{ forloop.index }}</p>
          </li>
        {%- endfor -%}
      </ul>
    </div>

    <dialog
      class="look-inside-viewer"
      aria-label="{{ s.heading | strip_html | default: 'Look inside' | escape }}: {{ product.title | escape }}"
      data-viewer
    >
      <div class="look-inside-viewer__bar">
        <p
          class="look-inside-viewer__counter"
          aria-live="polite"
        >
          Page <span data-viewer-current>1</span> of {{ page_count }}
        </p>
        <button
          type="button"
          class="look-inside-viewer__button"
          data-viewer-close
          aria-label="Close"
        >
          {% render 'brand-icon', name: 'close' %}
        </button>
      </div>

      <ul
        class="look-inside-viewer__slides"
        role="list"
        data-viewer-slides
      >
        {%- for page in pages -%}
          {%- liquid
            assign image = page.preview_image | default: page
            assign alt = page.alt | default: image.alt
            if alt == blank
              assign alt = product.title | append: ', sample page ' | append: forloop.index
            endif
          -%}
          <li class="look-inside-viewer__slide">
            {%- comment -%} Not lazy: lazy images inside a closed dialog never load. The viewer sets the src when it opens. {%- endcomment -%}
            <img
              class="look-inside-viewer__image"
              data-src="{{ image | image_url: width: 2000 }}"
              width="{{ image.width }}"
              height="{{ image.height }}"
              alt="{{ alt | escape }}"
            >
          </li>
        {%- endfor -%}
      </ul>

      {%- if page_count > 1 -%}
        <button
          type="button"
          class="look-inside-viewer__button look-inside-viewer__nav look-inside-viewer__nav--prev"
          data-viewer-step="-1"
          aria-label="Previous page"
        >
          {% render 'brand-icon', name: 'arrow-left' %}
        </button>
        <button
          type="button"
          class="look-inside-viewer__button look-inside-viewer__nav look-inside-viewer__nav--next"
          data-viewer-step="1"
          aria-label="Next page"
        >
          {% render 'brand-icon', name: 'arrow-right' %}
        </button>

        <ul
          class="look-inside-viewer__thumbs"
          role="list"
        >
          {%- for page in pages -%}
            {%- assign image = page.preview_image | default: page -%}
            <li>
              <button
                type="button"
                class="look-inside-viewer__thumb"
                data-viewer-thumb
                data-index="{{ forloop.index0 }}"
                aria-label="Page {{ forloop.index }}"
              >
                <img
                  data-src="{{ image | image_url: width: 160 }}"
                  width="64"
                  height="88"
                  alt=""
                >
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </dialog>
  </book-look-inside>
{%- elsif request.design_mode -%}
  <div class="look-inside look-inside--empty">
    <p class="look-inside__editor-note text-small">
      <strong>Look inside</strong> — add sample pages to this product's <em>Look inside</em>
      metafield (custom.look_inside) to show them here. Visitors don't see this note.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .look-inside {
    display: block;
    padding-block: var(--space-9);
    overflow: hidden;
  }

  .look-inside__container {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .look-inside__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    margin-bottom: var(--space-7);
  }

  .look-inside__intro {
    max-width: 44rem;
  }

  .look-inside__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    color: var(--color-ink-muted);
  }

  .look-inside__eyebrow::before {
    content: '';
    flex: none;
    width: 8px;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: var(--color-leaf);
  }

  .look-inside__heading {
    margin: 0;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .look-inside__heading :is(em, i) {
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    color: var(--color-grape);
  }

  .look-inside__text {
    margin: var(--space-4) 0 0;
    font-size: 17px;
    color: var(--color-ink-muted);
  }

  .look-inside__arrows[hidden] {
    display: none;
  }

  .look-inside__arrows {
    display: flex;
    flex: none;
    gap: var(--space-3);
  }

  .look-inside__arrow {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    color: var(--color-ink);
    background: var(--color-card);
    border: var(--stroke-sm) solid var(--color-line-strong);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease, border-color 150ms ease, opacity 150ms ease;
  }

  .look-inside__arrow:hover:not([disabled]) {
    color: #fff;
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .look-inside__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .look-inside__arrow:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring, var(--color-grape));
    outline-offset: var(--focus-ring-offset);
  }

  /* The row bleeds off the right edge, so there are always more pages to see. */
  .look-inside__track {
    display: flex;
    gap: var(--space-6);
    margin: 0 calc(var(--page-margin) * -1);
    padding: var(--space-3) var(--page-margin) var(--space-6);
    overflow-x: auto;
    list-style: none;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--page-margin);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .look-inside__track::-webkit-scrollbar {
    display: none;
  }

  .look-inside__item {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: var(--space-4);
    scroll-snap-align: start;
  }

  .look-inside__page {
    position: relative;
    display: block;
    height: clamp(320px, 36vw, 520px);
    aspect-ratio: var(--ratio);
    padding: 0;
    overflow: hidden;
    background: #fff;
    border: 0;
    border-radius: var(--radius-image);
    box-shadow: var(--shadow-book, var(--shadow-lg));
    cursor: zoom-in;
    transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 400ms ease;
  }

  .look-inside__page:hover {
    transform: translateY(-6px) rotate(-0.6deg);
    box-shadow: var(--shadow-lg);
  }

  .look-inside__page:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring, var(--color-grape));
    outline-offset: var(--focus-ring-offset);
  }

  .look-inside__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .look-inside__zoom {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    background: rgb(var(--color-ink-rgb) / 0.85);
    border-radius: var(--radius-full);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .look-inside__page:is(:hover, :focus-visible) .look-inside__zoom {
    opacity: 1;
    transform: none;
  }

  .look-inside__number {
    margin: 0;
    color: var(--color-ink-muted);
  }

  .look-inside--empty {
    padding: var(--space-5) var(--page-margin);
  }

  .look-inside__editor-note {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    color: var(--color-ink-muted);
    border: var(--stroke-md) dashed var(--color-line-strong);
    border-radius: var(--radius-md);
  }

  /* ---------- Viewer ---------- */

  .look-inside-viewer {
    width: 100vw;
    max-width: 100vw;
    height: 100svh;
    max-height: 100svh;
    margin: 0;
    padding: 0;
    color: var(--color-ink);
    background: var(--color-paper-deep);
    border: 0;
  }

  .look-inside-viewer[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .look-inside-viewer::backdrop {
    background: rgb(var(--color-ink-rgb) / 0.5);
  }

  .look-inside-viewer__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
  }

  .look-inside-viewer__counter {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }

  .look-inside-viewer__slides {
    display: flex;
    height: 100%;
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    overflow-y: hidden;
    list-style: none;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior: contain;
  }

  .look-inside-viewer__slides::-webkit-scrollbar {
    display: none;
  }

  .look-inside-viewer__slide {
    display: flex;
    flex: 0 0 100%;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 0;
    padding: 0 clamp(var(--space-4), 8vw, 120px);
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  .look-inside-viewer__image {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    background: #fff;
    border-radius: var(--radius-image);
    box-shadow: var(--shadow-book, var(--shadow-lg));
  }

  .look-inside-viewer__button {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    color: var(--color-ink);
    background: var(--color-card);
    border: var(--stroke-sm) solid var(--color-line);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
  }

  .look-inside-viewer__button:hover:not([disabled]) {
    color: #fff;
    background: var(--color-ink);
    border-color: var(--color-ink);
  }

  .look-inside-viewer__button[disabled] {
    opacity: 0.35;
    cursor: default;
  }

  .look-inside-viewer :is(button):focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring, var(--color-grape));
    outline-offset: var(--focus-ring-offset);
  }

  .look-inside-viewer__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .look-inside-viewer__nav--prev {
    left: var(--space-5);
  }

  .look-inside-viewer__nav--next {
    right: var(--space-5);
  }

  .look-inside-viewer__thumbs {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-4) var(--space-5) calc(var(--space-4) + env(safe-area-inset-bottom));
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .look-inside-viewer__thumb {
    display: block;
    width: 48px;
    height: 64px;
    padding: 0;
    overflow: hidden;
    background: #fff;
    border: var(--stroke-sm) solid var(--color-line);
    border-radius: var(--radius-image);
    opacity: 0.55;
    cursor: pointer;
    transition: opacity 200ms ease, border-color 200ms ease;
  }

  .look-inside-viewer__thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .look-inside-viewer__thumb:hover,
  .look-inside-viewer__thumb[aria-current='true'] {
    opacity: 1;
  }

  .look-inside-viewer__thumb[aria-current='true'] {
    border-color: var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-ink);
  }

  @media screen and (max-width: 749px) {
    .look-inside {
      padding-block: var(--space-8);
    }

    .look-inside__header {
      margin-bottom: var(--space-6);
    }

    .look-inside__arrows {
      display: none;
    }

    .look-inside__track {
      gap: var(--space-4);
    }

    .look-inside__page {
      height: 92vw;
      max-height: 440px;
    }

    .look-inside-viewer__slide {
      padding: 0 var(--space-3);
    }

    .look-inside-viewer__nav {
      display: none;
    }

    .look-inside-viewer__thumbs {
      justify-content: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .look-inside__page,
    .look-inside__zoom,
    .look-inside__arrow,
    .look-inside-viewer__thumb {
      transition: none;
    }

    .look-inside__page:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Look inside",
  "tag": "section",
  "class": "look-inside-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the images in the product's Look inside metafield (custom.look_inside)."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Sample pages"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Put a word in italics to give it the accent colour.",
      "default": "Take a <em>look</em> inside"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Turn a few pages before it arrives at your door. Click any page to read it full screen."
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "paper-deep", "label": "Paper deep" },
        { "value": "sky-soft", "label": "Sky soft" },
        { "value": "leaf-soft", "label": "Leaf soft" }
      ],
      "default": "paper-deep"
    }
  ],
  "presets": [
    {
      "name": "Look inside"
    }
  ]
}
{% endschema %}
