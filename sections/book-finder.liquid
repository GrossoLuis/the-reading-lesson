{%- comment -%}
  Book finder: "Which book is right for my child?"

  Four questions, one at a time: the child's age, what they want to practise (reading,
  writing, math or a bit of everything), where they are with reading, and the preferred
  format. The answers score every book of a collection on the client
  (assets/book-finder.js) and the best 2–4 are shown as cards with why they fit and an
  Add to cart button.

  What each book is, read from the product:
  - Ages and reading level: metafields custom.age_range and custom.reading_level. When
    empty, they come from the grade collections the book is in (Preschool → 3–5 ·
    Pre-reader, Kindergarten → 3–5 · Emerging, First grade → 6–8 · Early, Second and
    Third grade → 6–8 · Independent, Fourth and Fifth grade → 9–12 · Confident).
  - Subjects: the subject collections picked in the section settings, the product tags
    "reading", "writing" and "math", and the same words in the title ("handwriting"
    counts as writing). A "bundle" with no subject covers all three.
  - Formats: the variant titles. "ebook", "pdf" or "digital" is digital, anything else
    physical.

  Every step tints the frame (data-stage): sky, tomato, sun, leaf, then grape for the
  results. Products are read from the chosen collection, else the current one, else all
  products (first 50).
{%- endcomment -%}

<script
  type="module"
  src="{{ 'book-finder.js' | asset_url }}"
></script>

{%- liquid
  assign s = section.settings
  assign source = s.collection
  if source == blank
    assign source = collection
  endif
  if source == blank
    assign source = collections.all
  endif
  # The page's own collection is paginated by the grid; a fresh lookup isn't.
  assign source = collections[source.handle] | default: source

  assign age_values = '3-5,6-8,9-12' | split: ','
  if s.include_toddlers
    assign age_values = '0-2,3-5,6-8,9-12' | split: ','
  endif

  assign reading_handle = s.reading_collection.handle | default: '-'
  assign writing_handle = s.writing_collection.handle | default: '-'
  assign math_handle = s.math_collection.handle | default: '-'

  assign level_values = 'Pre-reader,Emerging reader,Early reader,Independent reader,Confident reader' | split: ','
  assign level_labels = s.level_1 | append: '|' | append: s.level_2 | append: '|' | append: s.level_3 | append: '|' | append: s.level_4 | append: '|' | append: s.level_5 | split: '|'
-%}

<book-finder
  class="book-finder surface-{{ s.surface }}"
  data-stage="age"
  data-results-count="{{ s.results_count }}"
>
  <div class="book-finder__container">
    <div class="book-finder__frame">
      <header class="book-finder__intro">
        {%- if s.eyebrow != blank -%}
          <p class="book-finder__eyebrow text-eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="book-finder__heading text-display">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="book-finder__text text-lead">{{ s.text }}</div>
        {%- endif -%}
      </header>

      <div class="book-finder__panel">
        <div
          class="book-finder__progress"
          data-progress
        >
          <p
            class="book-finder__step-count text-small"
            aria-live="polite"
          >
            Question <span data-step-number>1</span> of 4
          </p>
          <div
            class="book-finder__bar"
            aria-hidden="true"
          >
            <span class="book-finder__segment book-finder__segment--age"></span>
            <span class="book-finder__segment book-finder__segment--subject"></span>
            <span class="book-finder__segment book-finder__segment--level"></span>
            <span class="book-finder__segment book-finder__segment--format"></span>
          </div>
        </div>

        {%- comment -%} ---------- Question 1: age ---------- {%- endcomment -%}
        <fieldset
          class="book-finder__step"
          data-step="0"
        >
          <legend class="book-finder__question h4">{{ s.question_age }}</legend>
          <div class="book-finder__options book-finder__options--tiles">
            {%- for age in age_values -%}
              <button
                type="button"
                class="book-finder__option"
                data-question="age"
                data-value="{{ age }}"
              >
                <span class="book-finder__option-big">{{ age | replace: '-', '–' }}</span>
                <span class="book-finder__option-small">years</span>
              </button>
            {%- endfor -%}
          </div>
        </fieldset>

        {%- comment -%} ---------- Question 2: subject ---------- {%- endcomment -%}
        <fieldset
          class="book-finder__step"
          data-step="1"
          hidden
        >
          <legend class="book-finder__question h4">{{ s.question_subject }}</legend>
          <div class="book-finder__options book-finder__options--tiles book-finder__options--four">
            <button
              type="button"
              class="book-finder__option"
              data-question="subject"
              data-value="reading"
            >
              {% render 'brand-icon', name: 'book', size: 26 %}
              <span class="book-finder__option-label">Reading</span>
            </button>
            <button
              type="button"
              class="book-finder__option"
              data-question="subject"
              data-value="writing"
            >
              <svg
                class="brand-icon"
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M15.75 4.75 19.25 8.25 9 18.5l-4.25.75.75-4.25L15.75 4.75ZM13.75 6.75l3.5 3.5"/>
              </svg>
              <span class="book-finder__option-label">Writing</span>
            </button>
            <button
              type="button"
              class="book-finder__option"
              data-question="subject"
              data-value="math"
            >
              <svg
                class="brand-icon"
                width="26"
                height="26"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                focusable="false"
              >
                <path d="M7.75 4.75v6M4.75 7.75h6M14.25 7.75h5M4.75 16.25h6M14.25 14.75h5M14.25 17.75h5"/>
              </svg>
              <span class="book-finder__option-label">Math</span>
            </button>
            <button
              type="button"
              class="book-finder__option"
              data-question="subject"
              data-value="all"
            >
              {% render 'brand-icon', name: 'star', size: 26 %}
              <span class="book-finder__option-label">A bit of everything</span>
            </button>
          </div>
        </fieldset>

        {%- comment -%} ---------- Question 3: reading level ---------- {%- endcomment -%}
        <fieldset
          class="book-finder__step"
          data-step="2"
          hidden
        >
          <legend class="book-finder__question h4">{{ s.question_level }}</legend>
          <div class="book-finder__options">
            {%- for level in level_values -%}
              <button
                type="button"
                class="book-finder__option book-finder__option--row"
                data-question="level"
                data-value="{{ level }}"
              >
                <span class="book-finder__option-label">{{ level_labels[forloop.index0] | default: level }}</span>
                <span class="book-finder__option-small">{{ level }}</span>
              </button>
            {%- endfor -%}
          </div>
        </fieldset>

        {%- comment -%} ---------- Question 4: format ---------- {%- endcomment -%}
        <fieldset
          class="book-finder__step"
          data-step="3"
          hidden
        >
          <legend class="book-finder__question h4">{{ s.question_format }}</legend>
          <div class="book-finder__options book-finder__options--tiles book-finder__options--formats">
            <button
              type="button"
              class="book-finder__option"
              data-question="format"
              data-value="physical"
            >
              {% render 'brand-icon', name: 'book', size: 26 %}
              <span class="book-finder__option-label">Physical book</span>
            </button>
            <button
              type="button"
              class="book-finder__option"
              data-question="format"
              data-value="digital"
            >
              {% render 'brand-icon', name: 'download', size: 26 %}
              <span class="book-finder__option-label">eBook / printable</span>
            </button>
            <button
              type="button"
              class="book-finder__option"
              data-question="format"
              data-value="any"
            >
              {% render 'brand-icon', name: 'heart', size: 26 %}
              <span class="book-finder__option-label">Either is fine</span>
            </button>
          </div>
        </fieldset>

        {%- comment -%} ---------- Results ---------- {%- endcomment -%}
        <div
          class="book-finder__results"
          data-results
          hidden
          tabindex="-1"
        >
          <div class="book-finder__results-head">
            <p class="book-finder__question h4">{{ s.results_heading }}</p>
            <div
              class="book-finder__arrows"
              data-arrows
              hidden
            >
              <button
                type="button"
                class="book-finder__arrow"
                data-prev
                aria-label="Previous book"
              >
                {%- render 'brand-icon', name: 'arrow-left', size: 20 -%}
              </button>
              <button
                type="button"
                class="book-finder__arrow"
                data-next
                aria-label="Next book"
              >
                {%- render 'brand-icon', name: 'arrow-right', size: 20 -%}
              </button>
            </div>
          </div>
          <ul
            class="book-finder__picks"
            role="list"
            data-picks
          ></ul>
          <div
            class="book-finder__empty"
            data-empty
            hidden
          >
            <p>{{ s.empty_text }}</p>
          </div>
        </div>

        <div class="book-finder__nav">
          <button
            type="button"
            class="book-finder__link"
            data-back
            hidden
          >
            ← Back
          </button>
          <button
            type="button"
            class="book-finder__link"
            data-restart
            hidden
          >
            Start over
          </button>
        </div>
      </div>
    </div>
  </div>

  <script
    type="application/json"
    data-books
  >
    [
      {%- for product in source.products limit: 50 -%}
        {%- liquid
          # ---------- Formats ----------
          assign has_physical = false
          assign has_digital = false
          assign physical_variant = blank
          assign digital_variant = blank
          for v in product.variants
            assign t = v.title | downcase
            if t contains 'ebook' or t contains 'pdf' or t contains 'digital'
              assign has_digital = true
              if digital_variant == blank and v.available
                assign digital_variant = v.id
              endif
            else
              assign has_physical = true
              if physical_variant == blank and v.available
                assign physical_variant = v.id
              endif
            endif
          endfor

          # ---------- Ages and levels: metafields, else grade collections ----------
          assign ages_csv = ''
          assign levels_csv = ''
          for c in product.collections
            assign h = c.handle
            if h contains 'preschool' or h contains 'pre-k'
              assign ages_csv = ages_csv | append: ',3-5'
              assign levels_csv = levels_csv | append: ',Pre-reader'
            elsif h contains 'kindergarten'
              assign ages_csv = ages_csv | append: ',3-5'
              assign levels_csv = levels_csv | append: ',Emerging reader'
            elsif h contains 'first-grade'
              assign ages_csv = ages_csv | append: ',6-8'
              assign levels_csv = levels_csv | append: ',Early reader'
            elsif h contains 'second-grade' or h contains 'third-grade'
              assign ages_csv = ages_csv | append: ',6-8'
              assign levels_csv = levels_csv | append: ',Independent reader'
            elsif h contains 'fourth-grade' or h contains 'fifth-grade'
              assign ages_csv = ages_csv | append: ',9-12'
              assign levels_csv = levels_csv | append: ',Confident reader'
            endif
          endfor
          assign age_field = product.metafields.custom.age_range.value
          if age_field != blank
            assign ages_csv = ',' | append: age_field
          endif
          assign level_field = product.metafields.custom.reading_level.value
          if level_field != blank
            assign levels_csv = ',' | append: level_field
          endif
          assign ages = ages_csv | remove_first: ',' | split: ',' | uniq
          assign levels = levels_csv | remove_first: ',' | split: ',' | uniq

          # ---------- Subjects ----------
          assign title = product.title | downcase
          assign tags = product.tags | join: ',' | downcase | split: ','
          assign handles = product.collections | map: 'handle'
          assign subjects_csv = ''
          if title contains 'reading' or tags contains 'reading' or handles contains reading_handle
            assign subjects_csv = subjects_csv | append: ',reading'
          endif
          if title contains 'writing' or tags contains 'writing' or handles contains writing_handle
            assign subjects_csv = subjects_csv | append: ',writing'
          endif
          if title contains 'math' or tags contains 'math' or handles contains math_handle
            assign subjects_csv = subjects_csv | append: ',math'
          endif
          if subjects_csv == blank and title contains 'bundle'
            assign subjects_csv = ',reading,writing,math'
          endif
          assign subjects = subjects_csv | remove_first: ',' | split: ','

          # ---------- Card ----------
          assign tints = 'sky,sun,tomato,grape,leaf' | split: ','
          assign tint_index = product.id | modulo: 5
          assign tint = tints[tint_index]
          assign card_colour = product.metafields.custom.card_colour.value | downcase
          if tints contains card_colour
            assign tint = card_colour
          endif
          assign author = product.metafields.custom.author.value
          assign author = author.name.value | default: author
          assign image = product.featured_image
          assign compare_at = blank
          if product.compare_at_price > product.price
            assign compare_at = product.compare_at_price | money
          endif
        -%}
        {
          "id": {{ product.id | json }},
          "title": {{ product.title | json }},
          "url": {{ product.url | json }},
          "image": {% if image %}{{ image | image_url: width: 480 | json }}{% else %}null{% endif %},
          "alt": {{ image.alt | default: product.title | json }},
          "author": {{ author | default: '' | json }},
          "tint": {{ tint | json }},
          "price": {{ product.price | money | json }},
          "compareAt": {{ compare_at | default: '' | json }},
          "priceVaries": {{ product.price_varies | json }},
          "available": {{ product.available | json }},
          "ages": {{ ages | json }},
          "levels": {{ levels | json }},
          "subjects": {{ subjects | json }},
          "physical": {{ has_physical | json }},
          "digital": {{ has_digital | json }},
          "variant": {{ product.selected_or_first_available_variant.id | json }},
          "physicalVariant": {{ physical_variant | default: null | json }},
          "digitalVariant": {{ digital_variant | default: null | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</book-finder>

{% stylesheet %}
  .book-finder {
    display: block;
    padding-block: var(--space-9);
  }

  /* The steps are swapped with the hidden attribute; keep it ahead of display rules. */
  .book-finder [hidden] {
    display: none !important;
  }

  .book-finder__container {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  /* Each step has its colour: the frame's tint and the accents follow it
     (data-stage, set by assets/book-finder.js). */
  .book-finder[data-stage='age'] {
    --finder-soft: var(--color-sky-soft);
    --finder-accent: var(--color-sky-deep);
  }

  .book-finder[data-stage='subject'] {
    --finder-soft: var(--color-tomato-soft);
    --finder-accent: var(--color-tomato);
  }

  .book-finder[data-stage='level'] {
    --finder-soft: var(--color-sun-soft);
    --finder-accent: var(--color-sun-deep);
  }

  .book-finder[data-stage='format'] {
    --finder-soft: var(--color-leaf-soft);
    --finder-accent: var(--color-leaf-deep);
  }

  .book-finder[data-stage='results'] {
    --finder-soft: var(--color-grape-soft);
    --finder-accent: var(--color-grape);
  }

  /* Colour-bar frame, the signature element of Our Story. */
  .book-finder__frame {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(var(--space-6), 5vw, var(--space-9));
    align-items: start;
    padding: clamp(var(--space-6), 5vw, var(--space-8));
    background: var(--finder-soft, var(--color-paper-deep));
    border-style: solid;
    border-width: var(--colour-bar-thickness);
    border-color: var(--color-sky) var(--color-grape) var(--color-tomato) var(--color-sun);
    border-radius: var(--radius-xl);
    transition: background-color 400ms ease;
  }

  /* The picks need the room: the intro narrows on the results. */
  .book-finder[data-stage='results'] .book-finder__frame {
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
  }

  /* ---------- Intro ---------- */

  .book-finder__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    color: var(--color-ink-muted);
  }

  .book-finder__eyebrow::before {
    content: '';
    flex: none;
    width: 8px;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: var(--finder-accent, var(--color-tomato));
    transition: background-color 400ms ease;
  }

  .book-finder__heading {
    margin: 0;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .book-finder__heading :is(em, i) {
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    color: var(--color-grape);
  }

  .book-finder[data-stage='results'] .book-finder__heading {
    font-size: clamp(32px, 3.4vw, 44px);
  }

  .book-finder__text {
    margin-top: var(--space-4);
    color: var(--color-ink-muted);
  }

  .book-finder__text > * {
    margin: 0;
  }

  /* ---------- Panel ---------- */

  .book-finder__panel {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }

  .book-finder__progress {
    display: grid;
    gap: var(--space-2);
  }

  .book-finder__step-count {
    margin: 0;
    color: var(--color-ink-muted);
  }

  /* One segment per question, each filling with its step colour. */
  .book-finder__bar {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .book-finder__segment {
    height: 6px;
    background: rgb(var(--color-ink-rgb) / 0.12);
    border-radius: var(--radius-full);
    transition: background-color 300ms ease;
  }

  .book-finder__segment--age {
    background: var(--color-sky);
  }

  :is([data-stage='subject'], [data-stage='level'], [data-stage='format']) .book-finder__segment--subject {
    background: var(--color-tomato);
  }

  :is([data-stage='level'], [data-stage='format']) .book-finder__segment--level {
    background: var(--color-sun);
  }

  [data-stage='format'] .book-finder__segment--format {
    background: var(--color-leaf);
  }

  .book-finder__step {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .book-finder__question {
    margin: 0 0 var(--space-4);
    padding: 0;
    color: var(--color-ink);
  }

  .book-finder__options {
    display: grid;
    gap: var(--space-3);
  }

  .book-finder__options--tiles {
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  }

  .book-finder__options--four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .book-finder__options--formats {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .book-finder__option {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: var(--space-2);
    min-height: 96px;
    padding: var(--space-4);
    font: inherit;
    color: var(--color-ink);
    text-align: center;
    background: var(--color-paper);
    border: var(--stroke-sm) solid var(--color-line-strong);
    border-radius: var(--radius-lg);
    cursor: pointer;
    transition: border-color 150ms ease, background-color 150ms ease, transform 150ms ease;
  }

  .book-finder__option:hover {
    border-color: var(--finder-accent, var(--color-ink));
    box-shadow: inset 0 0 0 1px var(--finder-accent, var(--color-ink));
  }

  .book-finder__option:active {
    transform: translateY(1px);
  }

  .book-finder__option:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring, var(--color-grape));
    outline-offset: var(--focus-ring-offset);
  }

  .book-finder__option.is-selected {
    background: var(--color-card);
    border-color: var(--finder-accent, var(--color-ink));
    box-shadow: inset 0 0 0 1px var(--finder-accent, var(--color-ink));
  }

  .book-finder__option .brand-icon {
    color: var(--finder-accent, var(--color-ink));
  }

  .book-finder__option--row {
    grid-template-columns: minmax(0, 1fr) auto;
    justify-items: start;
    align-items: center;
    min-height: 56px;
    padding-block: var(--space-3);
    text-align: left;
  }

  .book-finder__option-big {
    font-family: var(--font-heading--family);
    font-size: 28px;
    font-weight: 600;
    line-height: 1;
  }

  .book-finder__option-label {
    font-weight: 600;
  }

  .book-finder__option-small {
    font-size: 13px;
    color: var(--color-ink-muted);
  }

  /* ---------- Results: book cards ---------- */

  .book-finder__results:focus {
    outline: none;
  }

  .book-finder__results-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .book-finder__results-head .book-finder__question {
    margin: 0;
  }

  .book-finder__arrows {
    display: flex;
    flex: none;
    gap: var(--space-2);
  }

  .book-finder__arrow {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    color: var(--color-ink);
    background: var(--color-card);
    border: var(--stroke-sm) solid var(--color-line-strong);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease, opacity 150ms ease;
  }

  .book-finder__arrow:hover:not(:disabled) {
    color: var(--color-on-grape);
    background: var(--color-grape);
    border-color: var(--color-grape);
  }

  .book-finder__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .book-finder__arrow:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus-ring, var(--color-grape));
    outline-offset: var(--focus-ring-offset);
  }

  /* Track: two cards and a tenth of the next on desktop, one and a tenth on mobile.
     Swiped natively on touch, dragged with the mouse (assets/book-finder.js). */
  .book-finder__picks {
    --visible: 2.1;

    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--space-4) * (var(--visible) - 0.1)) / var(--visible));
    gap: var(--space-4);
    margin: 0 calc(var(--space-3) * -1);
    padding: var(--space-2) var(--space-3) var(--space-5);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--space-3);
    scrollbar-width: none;
    list-style: none;
    cursor: grab;
  }

  .book-finder__picks::-webkit-scrollbar {
    display: none;
  }

  .book-finder__picks.is-dragging {
    scroll-snap-type: none;
    cursor: grabbing;
    user-select: none;
  }

  .book-finder__picks.is-dragging a,
  .book-finder__picks.is-dragging img {
    pointer-events: none;
  }

  .book-finder__pick {
    scroll-snap-align: start;
  }

  .book-finder__pick {
    --pick-tint: var(--color-sky-soft);

    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-card);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 2px rgb(var(--color-ink-rgb) / 0.06), 0 8px 24px rgb(var(--color-ink-rgb) / 0.08);
    animation: book-finder-pick 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  .book-finder__pick--sun {
    --pick-tint: var(--color-sun-soft);
  }

  .book-finder__pick--tomato {
    --pick-tint: var(--color-tomato-soft);
  }

  .book-finder__pick--grape {
    --pick-tint: var(--color-grape-soft);
  }

  .book-finder__pick--leaf {
    --pick-tint: var(--color-leaf-soft);
  }

  @keyframes book-finder-pick {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .book-finder__badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 4px var(--space-3);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-on-tomato);
    background: var(--color-tomato);
    border-radius: var(--radius-full);
  }

  .book-finder__pick-media {
    display: grid;
    place-items: center;
    grid-template-rows: minmax(0, 1fr);
    height: clamp(220px, 20vw, 280px);
    padding: var(--space-5) var(--space-6) var(--space-4);
    background: var(--pick-tint);
  }

  .book-finder__pick-media img {
    width: auto;
    height: 100%;
    max-width: 100%;
    min-height: 0;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: var(--shadow-book, 0 6px 16px rgb(0 0 0 / 0.18));
    transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Products without an image get a plain cover with their title. */
  .book-finder__pick-cover {
    display: grid;
    place-items: center;
    height: 100%;
    aspect-ratio: 3 / 4;
    padding: var(--space-4) var(--space-3) var(--space-4) calc(var(--space-3) + 10px);
    font-family: var(--font-heading--family);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
    text-align: center;
    color: var(--color-ink);
    background:
      linear-gradient(90deg, rgb(var(--color-ink-rgb) / 0.85) 0 10px, transparent 10px),
      var(--color-card);
    border-radius: 4px;
    box-shadow: var(--shadow-book, 0 6px 16px rgb(0 0 0 / 0.18));
    transition: transform 400ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .book-finder__pick:hover .book-finder__pick-cover,
  .book-finder__pick:hover .book-finder__pick-media img {
    transform: translateY(-4px) rotate(-1.5deg);
  }

  .book-finder__pick-body {
    display: grid;
    flex: 1;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-4) 0;
  }

  .book-finder__pick-why {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book-finder__pick-why li {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--pick-tint);
    border-radius: var(--radius-full);
  }

  .book-finder__pick-why li::before {
    content: '✓';
    font-size: 11px;
    color: var(--color-leaf-deep);
  }

  .book-finder__pick-title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.25;
  }

  .book-finder__pick-title a {
    color: inherit;
    text-decoration: none;
  }

  .book-finder__pick-title a:hover {
    text-decoration: underline;
  }

  .book-finder__pick-author {
    margin: 0;
    font-size: 14px;
    color: var(--color-ink-muted);
  }

  .book-finder__pick-price {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-ink);
  }

  .book-finder__pick-price small {
    font-family: var(--font-body--family, inherit);
    font-size: 13px;
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  .book-finder__pick-price s {
    font-size: 15px;
    font-weight: 400;
    color: var(--color-ink-muted);
  }

  .book-finder__pick-actions {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4);
  }

  .book-finder__pick-actions .brand-button {
    width: 100%;
    min-height: 48px;
  }

  .book-finder__pick-actions .brand-button.is-loading {
    pointer-events: none;
    opacity: 0.7;
  }

  .book-finder__pick-link {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    text-decoration: none;
  }

  .book-finder__pick-link:hover {
    text-decoration: underline;
  }

  .book-finder__pick-error {
    margin: 0;
    font-size: 13px;
    color: var(--color-tomato-deep);
    text-align: center;
  }

  .book-finder__empty p {
    margin: 0;
    color: var(--color-ink-muted);
  }

  .book-finder__nav {
    display: flex;
    gap: var(--space-5);
  }

  .book-finder__link {
    padding: 0;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
    background: none;
    border: 0;
    text-decoration: underline;
    text-decoration-color: var(--color-line-strong);
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .book-finder__link:hover {
    text-decoration-color: currentcolor;
  }

  /* ---------- Responsive ---------- */

  @media screen and (max-width: 1199px) {
    .book-finder__options--four {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 989px) {
    .book-finder__frame,
    .book-finder[data-stage='results'] .book-finder__frame {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .book-finder__options--formats {
      grid-template-columns: minmax(0, 1fr);
    }

    .book-finder__options--formats .book-finder__option {
      grid-auto-flow: column;
      justify-content: start;
      min-height: 56px;
    }

    .book-finder__picks {
      --visible: 1.1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-finder__frame,
    .book-finder__eyebrow::before,
    .book-finder__segment,
    .book-finder__option,
    .book-finder__pick-media img {
      transition: none;
    }

    .book-finder__pick {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Book finder",
  "tag": "section",
  "class": "book-finder-section",
  "enabled_on": {
    "templates": ["collection", "index", "page", "list-collections"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Recommends books from their age and reading level (metafields, else grade collections), subject and format."
    },
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Book finder"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Put a word in italics to give it the accent colour.",
      "default": "Which book is right for <em>my child?</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Answer four quick questions and we’ll pick the books that fit where your child is today.</p>"
    },
    {
      "type": "header",
      "content": "Books"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to use the collection being viewed (or all products elsewhere). First 50 products."
    },
    {
      "type": "range",
      "id": "results_count",
      "label": "Books to recommend",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Subjects"
    },
    {
      "type": "paragraph",
      "content": "Books are matched to a subject by these collections, by the tags reading, writing and math, or by the word in their title."
    },
    {
      "type": "collection",
      "id": "reading_collection",
      "label": "Reading collection"
    },
    {
      "type": "collection",
      "id": "writing_collection",
      "label": "Writing collection"
    },
    {
      "type": "collection",
      "id": "math_collection",
      "label": "Math collection"
    },
    {
      "type": "header",
      "content": "Questions"
    },
    {
      "type": "text",
      "id": "question_age",
      "label": "Question 1 · age",
      "default": "How old is your child?"
    },
    {
      "type": "checkbox",
      "id": "include_toddlers",
      "label": "Include ages 0–2",
      "default": false
    },
    {
      "type": "text",
      "id": "question_subject",
      "label": "Question 2 · subject",
      "default": "What would you like to practise?"
    },
    {
      "type": "text",
      "id": "question_level",
      "label": "Question 3 · reading level",
      "default": "Where are they with reading?"
    },
    {
      "type": "text",
      "id": "level_1",
      "label": "Answer for Pre-reader",
      "default": "Not reading yet, still learning letters"
    },
    {
      "type": "text",
      "id": "level_2",
      "label": "Answer for Emerging reader",
      "default": "Knows letter sounds, starting to blend"
    },
    {
      "type": "text",
      "id": "level_3",
      "label": "Answer for Early reader",
      "default": "Reads simple words and short sentences"
    },
    {
      "type": "text",
      "id": "level_4",
      "label": "Answer for Independent reader",
      "default": "Reads short books on their own"
    },
    {
      "type": "text",
      "id": "level_5",
      "label": "Answer for Confident reader",
      "default": "Reads longer books with ease"
    },
    {
      "type": "text",
      "id": "question_format",
      "label": "Question 4 · format",
      "default": "Which format do you prefer?"
    },
    {
      "type": "header",
      "content": "Results"
    },
    {
      "type": "text",
      "id": "results_heading",
      "label": "Results heading",
      "default": "Our picks for your child"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "No match text",
      "default": "We couldn’t find an exact match yet. Get in touch and we’ll help you choose."
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "paper-deep", "label": "Paper deep" }
      ],
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Book finder"
    }
  ]
}
