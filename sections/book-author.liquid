{%- comment -%}
  Author on the product page, from the product's custom.author metaobject (name, photo,
  bio). An editorial scene rather than a card:

  - Left, the portrait in a ring of the four colour-bar colours (sky, sun, grape,
    tomato), with up to three covers of the author's other books fanned behind it, a
    tilted sun sticker and a few colour dots around.
  - Right, "Meet <name>" with the name in the accent italic, the bio as a lead, how many
    of their books are in the shop and a button to the author's page.
  - Below, a row of their other books (snippets/book-shelf.liquid).

  The other books come from the first 250 products of the catalogue: Liquid can't
  query products by metafield. Hidden when the product has no author; in the theme
  editor it shows a note.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign author = product.metafields.custom.author.value
  assign author_name = author.name.value | default: author
  assign author_url = author.system.url
  assign photo = author.photo.value
  assign bio = author.bio.value
  assign author_key = author.system.id | default: author

  assign book_count = 0
  assign cover_handles = ''
  if author != blank
    paginate collections.all.products by 250
      for book in collections.all.products
        assign book_author = book.metafields.custom.author.value
        assign book_key = book_author.system.id | default: book_author
        if book_key != blank and book_key == author_key
          assign book_count = book_count | plus: 1
          if book.id != product.id and book.featured_media
            assign cover_handles = cover_handles | append: book.handle | append: ','
          endif
        endif
      endfor
    endpaginate
  endif
  assign cover_handles = cover_handles | split: ','

  if s.show_books and author != blank
    capture shelf
      render 'book-shelf', source: 'author', value: author, exclude: product.id, limit: s.books_limit
    endcapture
  endif
-%}

{%- if author_name != blank -%}
  <div class="book-author surface-{{ s.surface }}">
    <div class="book-author__container">
      <div class="book-author__scene">
        <div class="book-author__stage">
          {%- for handle in cover_handles limit: 3 -%}
            {%- assign cover_class = 'book-author__cover book-author__cover--' | append: forloop.index -%}
            {{-
              all_products[handle].featured_media.preview_image
              | image_url: width: 360
              | image_tag: class: cover_class, width: 180, height: 240, loading: 'lazy', alt: ''
            -}}
          {%- endfor -%}

          <span class="book-author__dot book-author__dot--sky" aria-hidden="true"></span>
          <span class="book-author__dot book-author__dot--sun" aria-hidden="true"></span>
          <span class="book-author__dot book-author__dot--leaf" aria-hidden="true"></span>

          <div class="book-author__ring">
            <div class="book-author__portrait">
              {%- if photo != blank -%}
                {%- assign photo_image = photo.preview_image | default: photo -%}
                {{-
                  photo_image
                  | image_url: width: 720
                  | image_tag:
                    class: 'book-author__photo',
                    widths: '280, 400, 560, 720',
                    sizes: '(min-width: 990px) 340px, 240px',
                    loading: 'lazy',
                    alt: author_name
                -}}
              {%- else -%}
                <span class="book-author__initial" aria-hidden="true">{{ author_name | slice: 0 }}</span>
              {%- endif -%}
            </div>
          </div>

          {%- if s.sticker != blank -%}
            <span class="book-author__sticker">{{ s.sticker }}</span>
          {%- endif -%}
        </div>

        <div class="book-author__body">
          {%- if s.eyebrow != blank -%}
            <p class="book-author__eyebrow text-eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}
          <h2 class="book-author__name text-display">
            {{- s.heading_prefix }}
            <em>{{ author_name }}</em>
          </h2>
          {%- if bio != blank -%}
            <p class="book-author__bio text-lead">{{ bio | newline_to_br }}</p>
          {%- endif -%}

          <div class="book-author__footer">
            {%- if author_url != blank and s.link_label != blank -%}
              {%- assign link_label = s.link_label | replace: '[author]', author_name -%}
              {%- render 'brand-button', label: link_label, url: author_url, style: 'primary', arrow: true -%}
            {%- endif -%}
            {%- if book_count > 1 -%}
              <p class="book-author__count">
                <span class="book-author__count-number">{{ book_count }}</span>
                <span class="book-author__count-label">books in<br>our shop</span>
              </p>
            {%- endif -%}
          </div>
        </div>
      </div>

      {%- if shelf != blank -%}
        <div class="book-author__books">
          <h3 class="book-author__books-heading h4">
            {{- s.books_heading | replace: '[author]', author_name -}}
          </h3>
          {{ shelf }}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="book-author book-author--empty">
    <p class="book-author__editor-note text-small">
      <strong>Author</strong> — pick an author in this product's <em>Author</em> metafield
      (custom.author) to show this section. Visitors don't see this note.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .book-author {
    padding-block: var(--space-9);
    overflow: hidden;
  }

  .book-author__container {
    display: flex;
    flex-direction: column;
    gap: var(--space-9);
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .book-author__scene {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(var(--space-7), 7vw, var(--space-9));
    align-items: center;
  }

  /* ---------- Stage: ring, covers, sticker ---------- */

  .book-author__stage {
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 460px);
    aspect-ratio: 1;
    margin-inline: auto;
  }

  /* The four colour-bar colours as a ring around the portrait. */
  .book-author__ring {
    position: relative;
    z-index: 2;
    width: 76%;
    aspect-ratio: 1;
    padding: var(--colour-bar-thickness);
    background: conic-gradient(
      from -45deg,
      var(--color-sky) 0 25%,
      var(--color-grape) 0 50%,
      var(--color-tomato) 0 75%,
      var(--color-sun) 0 100%
    );
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-lg);
  }

  .book-author__portrait {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: var(--color-sky-soft);
    border: 6px solid var(--color-paper);
    border-radius: var(--radius-full);
  }

  .book-author__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-author__initial {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: clamp(88px, 10vw, 140px);
    color: var(--color-grape);
  }

  /* The author's other books, fanned behind the ring. */
  .book-author__cover {
    position: absolute;
    z-index: 1;
    width: 30%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--color-card);
    border-radius: var(--radius-image);
    box-shadow: var(--shadow-book, var(--shadow-md));
  }

  .book-author__cover--1 {
    top: 4%;
    left: -2%;
    transform: rotate(-12deg);
  }

  .book-author__cover--2 {
    right: -4%;
    top: 14%;
    transform: rotate(9deg);
  }

  .book-author__cover--3 {
    left: 6%;
    bottom: -2%;
    transform: rotate(7deg);
  }

  .book-author__dot {
    position: absolute;
    z-index: 3;
    border-radius: var(--radius-full);
  }

  .book-author__dot--sky {
    top: 6%;
    right: 18%;
    width: 18px;
    height: 18px;
    background: var(--color-sky);
  }

  .book-author__dot--sun {
    bottom: 14%;
    left: 4%;
    width: 12px;
    height: 12px;
    background: var(--color-sun);
  }

  .book-author__dot--leaf {
    right: 6%;
    bottom: 26%;
    width: 10px;
    height: 10px;
    background: var(--color-leaf);
  }

  /* Round sun sticker, tilted like the age seal on the cover. */
  .book-author__sticker {
    position: absolute;
    z-index: 4;
    right: 6%;
    bottom: 6%;
    display: grid;
    place-items: center;
    width: 96px;
    aspect-ratio: 1;
    padding: var(--space-3);
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: 15px;
    line-height: 1.15;
    text-align: center;
    color: var(--color-ink);
    background: var(--color-sun);
    border-radius: var(--radius-full);
    box-shadow: var(--shadow-md);
    transform: rotate(-10deg);
  }

  /* ---------- Text ---------- */

  .book-author__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .book-author__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    color: var(--color-ink-muted);
  }

  .book-author__eyebrow::before {
    content: '';
    flex: none;
    width: 8px;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: var(--color-sun);
  }

  .book-author__name {
    margin: 0;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .book-author__name em {
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    color: var(--color-grape);
  }

  /* The bio hangs from a short sun rule, like a note pinned to the page. */
  .book-author__bio {
    position: relative;
    margin: 0;
    padding-left: var(--space-5);
    color: var(--color-ink-muted);
    border-left: 3px solid var(--color-sun);
  }

  .book-author__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-6);
    margin-top: var(--space-2);
  }

  .book-author__count {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
  }

  .book-author__count-number {
    font-family: var(--font-heading--family);
    font-size: 44px;
    font-weight: 600;
    line-height: 1;
    color: var(--color-grape);
  }

  .book-author__count-label {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .book-author__books {
    padding-top: var(--space-7);
    border-top: var(--stroke-sm) solid var(--color-line);
  }

  .book-author__books-heading {
    margin: 0 0 var(--space-6);
    color: var(--color-ink);
  }

  .book-author--empty {
    padding: var(--space-5) var(--page-margin);
  }

  .book-author__editor-note {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    color: var(--color-ink-muted);
    border: var(--stroke-md) dashed var(--color-line-strong);
    border-radius: var(--radius-md);
  }

  @media screen and (max-width: 989px) {
    .book-author {
      padding-block: var(--space-8);
    }

    .book-author__container {
      gap: var(--space-8);
    }

    .book-author__scene {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .book-author__stage {
      width: min(100%, 340px);
    }
  }

  @media screen and (max-width: 749px) {
    .book-author__stage {
      width: min(86%, 300px);
    }

    .book-author__sticker {
      width: 76px;
      font-size: 12px;
    }

    .book-author__count-number {
      font-size: 36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Author",
  "tag": "section",
  "class": "book-author-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the author picked in the product's Author metafield (custom.author), with covers of their other books around the portrait."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The person behind the pages"
    },
    {
      "type": "text",
      "id": "heading_prefix",
      "label": "Heading before the name",
      "info": "The author's name follows, in the accent italic.",
      "default": "Meet"
    },
    {
      "type": "text",
      "id": "sticker",
      "label": "Sticker",
      "info": "Round sun sticker on the portrait. Leave empty to hide it.",
      "default": "Written with love"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "info": "[author] is replaced with the author's name. Links to the author's page.",
      "default": "All books by [author]"
    },
    {
      "type": "checkbox",
      "id": "show_books",
      "label": "Show the author's other books",
      "default": true
    },
    {
      "type": "text",
      "id": "books_heading",
      "label": "Books heading",
      "default": "More by [author]"
    },
    {
      "type": "range",
      "id": "books_limit",
      "label": "Books to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "paper-deep", "label": "Paper deep" },
        { "value": "sky-soft", "label": "Sky soft" }
      ],
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Author"
    }
  ]
}
{% endschema %}
