{%- comment -%}
  Why we love it: the staff note of a book, from the product's custom.why_we_love_it
  metafield.

  A paper-deep box in the colour-bar frame of Our Story (sky, grape, tomato, sun): the
  eyebrow and display heading on the left, the note in Besley on the right, signed.

  Renders nothing when the metafield is empty; in the theme editor it shows a note
  instead.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign note = product.metafields.custom.why_we_love_it.value | strip
-%}

{%- if note != blank -%}
  <div class="book-love surface-{{ s.surface }}">
    <div class="book-love__container">
      <div class="book-love__frame">
        <header class="book-love__header">
          {%- if s.eyebrow != blank -%}
            <p class="book-love__eyebrow text-eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}
          {%- if s.heading != blank -%}
            <h2 class="book-love__heading text-display">{{ s.heading }}</h2>
          {%- endif -%}
        </header>

        <figure class="book-love__note">
          <blockquote class="book-love__quote">
            {{- note | newline_to_br -}}
          </blockquote>
          {%- if s.signature != blank -%}
            <figcaption class="book-love__signature">— {{ s.signature }}</figcaption>
          {%- endif -%}
        </figure>
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="book-love book-love--empty">
    <p class="book-love__editor-note text-small">
      <strong>Why we love it</strong> — write this product's <em>Why we love it</em> metafield
      (custom.why_we_love_it) to show this section. Visitors don't see this note.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .book-love {
    padding-block: var(--space-9);
  }

  .book-love__container {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  /* Colour-bar frame, the signature element of Our Story. */
  .book-love__frame {
    
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: center;
    padding: clamp(var(--space-6), 6vw, var(--space-9));
    background: var(--color-paper-deep);
    border-style: solid;
    border-width: var(--colour-bar-thickness);
    border-color: var(--color-sky) var(--color-grape) var(--color-tomato) var(--color-sun);
    border-radius: var(--radius-xl);
  }

  .book-love__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    color: var(--color-ink-muted);
  }

  .book-love__eyebrow::before {
    content: '';
    flex: none;
    width: 8px;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: var(--color-tomato);
  }

  .book-love__heading {
    margin: 0;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .book-love__heading :is(em, i) {
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    color: var(--color-grape);
  }

  .book-love__note {
    margin: 0;
  }

  .book-love__quote {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(20px, 1.9vw, 26px);
    font-weight: 400;
    line-height: 1.55;
    color: var(--color-ink);
    text-wrap: pretty;
  }

  .book-love__signature {
    margin-top: var(--space-5);
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: 18px;
    color: var(--color-grape);
  }

  .book-love--empty {
    padding: var(--space-5) var(--page-margin);
  }

  .book-love__editor-note {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    color: var(--color-ink-muted);
    border: var(--stroke-md) dashed var(--color-line-strong);
    border-radius: var(--radius-md);
  }

  @media screen and (max-width: 989px) {
    .book-love {
      padding-block: var(--space-8);
    }

    .book-love__frame {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-5);
    }
  }

  @media screen and (max-width: 749px) {
    .book-love__frame {
      padding: var(--space-6) var(--space-5);
      border-width: calc(var(--colour-bar-thickness) * 0.7);
      border-radius: var(--radius-lg);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Why we love it",
  "tag": "section",
  "class": "book-love-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the product's Why we love it metafield (custom.why_we_love_it). Hidden when it's empty."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "From our shelf"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Put a word in italics to give it the accent colour.",
      "default": "Why we <em>love</em> it"
    },
    {
      "type": "text",
      "id": "signature",
      "label": "Signature",
      "default": "The Reading Lesson team"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "paper-deep", "label": "Paper deep" }
      ],
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Why we love it"
    }
  ]
}
{% endschema %}
