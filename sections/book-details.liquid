{%- comment -%}
  Book details: the specs table and the staff note, from the product's metafields
  (METAFIELDS.md).

  Left: "The details", only the rows that have a value. Format, pages, dimensions and
  ISBN belong to the variant, so when the shopper picks another format on the product
  section (pdp:variant-change) the rows switch to it (assets/book-details.js).
  Right: "Why we love it", the staff note on a notebook-lined card, signed, with the
  highlight icons under it.

  The section hides itself when the product has none of these fields; in the theme
  editor it shows a note instead.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign book = product.metafields.custom
  assign current_variant = product.selected_or_first_available_variant

  assign author = book.author.value
  assign author_name = author.name.value | default: author
  assign series = book.series.value
  assign series_position = 0
  if series != blank
    for series_book in series.books.value
      if series_book.id == product.id
        assign series_position = forloop.index
        break
      endif
    endfor
  endif

  assign format_index = -1
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'format'
      assign format_index = forloop.index0
      break
    endif
  endfor

  comment
    Variant rows show when any variant has a value; the current variant's value fills them.
  endcomment
  assign has_pages = false
  assign has_dimensions = false
  assign has_isbn = false
  for variant in product.variants
    if variant.metafields.custom.pages.value != blank
      assign has_pages = true
    endif
    if variant.metafields.custom.dimensions.value != blank
      assign has_dimensions = true
    endif
    if variant.metafields.custom.isbn.value != blank
      assign has_isbn = true
    endif
  endfor

  assign current_pages = current_variant.metafields.custom.pages.value
  assign current_dimensions = current_variant.metafields.custom.dimensions.value
  assign current_isbn = current_variant.metafields.custom.isbn.value

  assign has_specs = false
  if format_index >= 0 or has_pages or has_dimensions or has_isbn or book.age_range.value != blank or book.reading_level.value != blank or book.publisher.value != blank or book.publication_year.value != blank or series != blank or author_name != blank
    assign has_specs = true
  endif

  assign note = book.why_we_love_it.value
  assign highlights = book.highlights.value
  assign has_note = false
  if note != blank or highlights != blank
    assign has_note = true
  endif
-%}

{%- if has_specs or has_note -%}
  <script
    type="module"
    src="{{ 'book-details.js' | asset_url }}"
  ></script>

  <book-details
    class="book-details surface-{{ s.surface }}"
    data-product-id="{{ product.id }}"
  >
    <div class="book-details__container{% unless has_specs and has_note %} book-details__container--single{% endunless %}">
      {%- if has_specs -%}
        <div class="book-details__specs">
          {%- if s.specs_heading != blank -%}
            <h2 class="book-details__heading h4">{{ s.specs_heading }}</h2>
          {%- endif -%}

          <dl class="book-details__list">
            {%- if author_name != blank -%}
              <div class="book-details__row">
                <dt>Author</dt>
                <dd>
                  {%- if author.system.url != blank -%}
                    <a href="{{ author.system.url }}">{{ author_name }}</a>
                  {%- else -%}
                    {{ author_name }}
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}

            {%- if format_index >= 0 -%}
              <div class="book-details__row">
                <dt>Format</dt>
                <dd data-spec="format">{{ current_variant.options[format_index] }}</dd>
              </div>
            {%- endif -%}

            {%- if book.age_range.value != blank -%}
              {%- assign age = book.age_range.value -%}
              <div class="book-details__row">
                <dt>Ages</dt>
                <dd>
                  <span
                    class="book-details__age"
                    style="--age-bg: var(--color-age-{{ age | handle }}); --age-fg: var(--color-on-age-{{ age | handle }});"
                  >
                    {{- age | replace: '-', '–' -}}
                  </span>
                </dd>
              </div>
            {%- endif -%}

            {%- if book.reading_level.value != blank -%}
              <div class="book-details__row">
                <dt>Reading level</dt>
                <dd>{{ book.reading_level.value }}</dd>
              </div>
            {%- endif -%}

            {%- if series != blank -%}
              <div class="book-details__row">
                <dt>Series</dt>
                <dd>
                  <a href="#book-series">{{ series.name.value }}</a>
                  {%- if series_position > 0 %}
                    · Book {{ series_position }}
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}

            {%- if has_pages -%}
              <div
                class="book-details__row"
                data-spec-row="pages"
                {% if current_pages == blank %}
                  hidden
                {% endif %}
              >
                <dt>Pages</dt>
                <dd data-spec="pages">{{ current_pages }}</dd>
              </div>
            {%- endif -%}

            {%- if has_dimensions -%}
              <div
                class="book-details__row"
                data-spec-row="dimensions"
                {% if current_dimensions == blank %}
                  hidden
                {% endif %}
              >
                <dt>Dimensions</dt>
                <dd data-spec="dimensions">{{ current_dimensions }}</dd>
              </div>
            {%- endif -%}

            {%- if has_isbn -%}
              <div
                class="book-details__row"
                data-spec-row="isbn"
                {% if current_isbn == blank %}
                  hidden
                {% endif %}
              >
                <dt>ISBN</dt>
                <dd
                  class="book-details__mono"
                  data-spec="isbn"
                >
                  {{- current_isbn -}}
                </dd>
              </div>
            {%- endif -%}

            {%- if book.publisher.value != blank -%}
              <div class="book-details__row">
                <dt>Publisher</dt>
                <dd>{{ book.publisher.value }}</dd>
              </div>
            {%- endif -%}

            {%- if book.publication_year.value != blank -%}
              <div class="book-details__row">
                <dt>Published</dt>
                <dd>{{ book.publication_year.value }}</dd>
              </div>
            {%- endif -%}
          </dl>
        </div>
      {%- endif -%}

      {%- if has_note -%}
        <div class="book-details__love">
          {%- if note != blank -%}
            <figure class="book-details__note surface-{{ s.note_surface }}">
              {%- if s.note_heading != blank -%}
                <p class="book-details__note-eyebrow text-eyebrow">
                  {%- render 'brand-icon', name: 'heart', size: 16 -%}
                  {{ s.note_heading }}
                </p>
              {%- endif -%}
              <blockquote class="book-details__note-text text-note">
                {{- note | newline_to_br -}}
              </blockquote>
              {%- if s.note_signature != blank -%}
                <figcaption class="book-details__note-signature">— {{ s.note_signature }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}

          {%- if highlights != blank -%}
            <ul
              class="book-details__highlights"
              role="list"
            >
              {%- for highlight in highlights -%}
                {%- liquid
                  case highlight
                    when 'Phonics-based'
                      assign icon = 'book'
                    when 'Read-aloud favourite'
                      assign icon = 'speaker'
                    when 'Hands-on activities'
                      assign icon = 'puzzle'
                    when 'Builds writing skills'
                      assign icon = 'pencil'
                    when 'Short daily lessons'
                      assign icon = 'clock'
                    when 'Award winner'
                      assign icon = 'rosette'
                    when 'Loved by kids'
                      assign icon = 'heart'
                    when 'Great gift'
                      assign icon = 'gift'
                    else
                      assign icon = 'star'
                  endcase
                  assign tones = 'sky,sun,leaf,grape,tomato' | split: ','
                  assign tone_index = forloop.index0 | modulo: 5
                -%}
                <li
                  class="book-details__highlight"
                  style="--tone: var(--color-{{ tones[tone_index] }}-soft); --tone-deep: var(--color-{{ tones[tone_index] }}{% if tones[tone_index] != 'grape' %}-deep{% endif %});"
                >
                  <span class="book-details__highlight-icon">{% render 'brand-icon', name: icon, size: 22 %}</span>
                  <span>{{ highlight }}</span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <script
      type="application/json"
      data-spec-variants
    >
      [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "format": {% if format_index >= 0 %}{{ variant.options[format_index] | json }}{% else %}null{% endif %},
            "pages": {{ variant.metafields.custom.pages.value | json }},
            "dimensions": {{ variant.metafields.custom.dimensions.value | json }},
            "isbn": {{ variant.metafields.custom.isbn.value | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </book-details>
{%- elsif request.design_mode -%}
  <div class="book-details book-details--empty">
    <p class="book-details__editor-note text-small">
      <strong>Book details</strong> — this product has none of the book metafields yet (age range,
      reading level, author, pages, ISBN, why we love it…). Fill them in the product's admin page; see
      METAFIELDS.md. Visitors don't see this note.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .book-details {
    display: block;
    padding-block: var(--space-8);
  }

  .book-details__container {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: start;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .book-details__container--single {
    grid-template-columns: minmax(0, 46rem);
  }

  .book-details__heading {
    margin: 0 0 var(--space-5);
    color: var(--color-ink);
  }

  /* ---------- Specs ---------- */

  .book-details__list {
    margin: 0;
    border-top: var(--stroke-sm) solid var(--color-line);
  }

  .book-details__row {
    display: grid;
    grid-template-columns: minmax(8rem, 2fr) 3fr;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: var(--stroke-sm) solid var(--color-line);
  }

  .book-details__row[hidden] {
    display: none;
  }

  .book-details__row dt {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink-muted);
  }

  .book-details__row dd {
    margin: 0;
    font-size: 15px;
    color: var(--color-ink);
  }

  .book-details__row a {
    color: var(--color-link);
    text-underline-offset: 3px;
  }

  .book-details__mono {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .book-details__age {
    display: inline-block;
    padding: 2px 10px;
    font-size: 13px;
    font-weight: 700;
    color: var(--age-fg, var(--color-ink));
    background: var(--age-bg, var(--color-sun));
    border-radius: var(--radius-full);
  }

  /* ---------- Why we love it ---------- */

  .book-details__love {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  /* Notebook lines behind the note, like a page from the program. */
  .book-details__note {
    position: relative;
    margin: 0;
    padding: var(--space-6) var(--space-6) var(--space-5);
    --note-line: 32px;

    background-color: var(--color-background);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent calc(var(--note-line) - 1px),
      var(--color-rule) calc(var(--note-line) - 1px),
      var(--color-rule) var(--note-line)
    );
    background-position: 0 var(--space-6);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .book-details__note-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-4);
    color: var(--color-tomato-deep);
  }

  .book-details__note-text {
    margin: 0;
    color: var(--color-ink);
    line-height: var(--note-line);
  }

  .book-details__note-signature {
    margin-top: var(--space-4);
    font-family: var(--font-accent--family);
    font-style: var(--font-accent--style);
    font-weight: var(--font-accent--weight);
    font-size: 17px;
    color: var(--color-ink-muted);
    text-align: right;
  }

  .book-details__highlights {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10.5rem, 1fr));
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book-details__highlight {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
    background: var(--color-card);
    border: var(--stroke-sm) solid var(--color-line);
    border-radius: var(--radius-md);
  }

  .book-details__highlight-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    color: var(--tone-deep, var(--color-ink));
    background: var(--tone, var(--color-paper-deep));
    border-radius: var(--radius-full);
  }

  .book-details--empty {
    padding: var(--space-5) var(--page-margin);
  }

  .book-details__editor-note {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: var(--space-4) var(--space-5);
    color: var(--color-ink-muted);
    border: var(--stroke-md) dashed var(--color-line-strong);
    border-radius: var(--radius-md);
  }

  @media screen and (max-width: 989px) {
    .book-details {
      padding-block: var(--space-7);
    }

    .book-details__container {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .book-details__note {
      padding: var(--space-5) var(--space-5) var(--space-4);
    }

    .book-details__row {
      grid-template-columns: minmax(6.5rem, 2fr) 3fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Book details",
  "tag": "section",
  "class": "book-details-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads the product's book metafields. Rows without a value are hidden."
    },
    {
      "type": "text",
      "id": "specs_heading",
      "label": "Details heading",
      "default": "The details"
    },
    {
      "type": "header",
      "content": "Why we love it"
    },
    {
      "type": "text",
      "id": "note_heading",
      "label": "Note eyebrow",
      "default": "Why we love it"
    },
    {
      "type": "text",
      "id": "note_signature",
      "label": "Signature",
      "default": "The Reading Lesson team"
    },
    {
      "type": "select",
      "id": "note_surface",
      "label": "Note background",
      "options": [
        { "value": "card", "label": "White" },
        { "value": "sun-soft", "label": "Sun soft" },
        { "value": "sky-soft", "label": "Sky soft" },
        { "value": "leaf-soft", "label": "Leaf soft" }
      ],
      "default": "card"
    },
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "paper-deep", "label": "Paper deep" }
      ],
      "default": "paper-deep"
    }
  ],
  "presets": [
    {
      "name": "Book details"
    }
  ]
}
{% endschema %}
