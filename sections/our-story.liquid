{%- comment -%}
  Our story (About us) with a short scrollytelling.

  1. Opening: eyebrow and display headline; the words rise in on load.
  2. Chapters (blocks): a sticky card on the left changes with each chapter (big
     statement, caption, colour bar that fills with the scroll, a count-up for
     numbers), while the chapter text on the right comes into focus.
  3. Pull quote whose words ink in as it scrolls past.
  4. The photo in a colour-bar frame, revealed by the scroll, and a closing button.

  Animation: GSAP 3.12.5 + ScrollTrigger (assets/gsap*.min.js, GSAP standard licence),
  driven by assets/our-story.js. Horizon
  scrolls .page-wrapper on desktop, so the triggers use that scroller there. With
  reduced motion, or if GSAP fails to load, everything shows statically.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign chapters = section.blocks | where: 'type', 'chapter'
  assign chapter_colors = 'sky,sun,leaf,grape,tomato' | split: ','
-%}

<script
  src="{{ 'gsap.min.js' | asset_url }}"
  defer
></script>
<script
  src="{{ 'gsap-scrolltrigger.min.js' | asset_url }}"
  defer
></script>
<script
  type="module"
  src="{{ 'our-story.js' | asset_url }}"
></script>

{%- comment -%}
  Hides the animated pieces before first paint so they don't flash, only when motion
  is allowed. our-story.js reveals them; a timeout undoes this if GSAP never arrives.
{%- endcomment -%}
<script>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var root = document.documentElement;
    root.classList.add('story-motion');
    setTimeout(function () {
      if (!window.gsap) root.classList.remove('story-motion');
    }, 4000);
  })();
</script>

<our-story
  class="story"
  data-section-id="{{ section.id }}"
>
  {%- comment -%} ---------- Opening ---------- {%- endcomment -%}
  <header class="story__intro">
    <div class="story__container">
      {%- if s.eyebrow != blank -%}
        <p class="story__eyebrow text-eyebrow" data-intro>{{ s.eyebrow }}</p>
      {%- endif -%}

      <h1
        class="story__headline text-display"
        data-split
        aria-label="{{ s.headline | append: ' ' | append: s.headline_accent | strip | escape }}"
      >
        {%- assign words = s.headline | split: ' ' -%}
        {%- for word in words -%}
          <span class="story__word" aria-hidden="true"><span>{{ word }}</span></span>
          {{- ' ' -}}
        {%- endfor -%}
        {%- if s.headline_accent != blank -%}
          <span class="story__word" aria-hidden="true"><span class="text-accent story__accent">{{ s.headline_accent }}</span></span>
        {%- endif -%}
      </h1>

      {%- if s.intro != blank -%}
        <p class="story__lede text-lead" data-intro>{{ s.intro }}</p>
      {%- endif -%}

      <div
        class="story__scroll-cue"
        aria-hidden="true"
        data-intro
      >
        <span class="story__dot story__dot--tomato"></span>
        <span class="story__dot story__dot--sun"></span>
        <span class="story__dot story__dot--sky"></span>
      </div>
    </div>
  </header>

  {%- comment -%} ---------- Chapters ---------- {%- endcomment -%}
  {%- if chapters.size > 0 -%}
    <div class="story__chapters">
      <div class="story__container story__chapters-grid">
        <div
          class="story__panel"
          aria-hidden="true"
        >
          <div class="story__card">
            <span class="story__bar">
              <span
                class="story__bar-fill"
                data-bar
              ></span>
            </span>

            <div class="story__states">
              {%- for block in chapters -%}
                {%- assign color = chapter_colors[forloop.index0] -%}
                <div
                  class="story__state{% if forloop.first %} is-active{% endif %}"
                  data-state
                  style="--chapter-color: var(--color-{{ color }}); --chapter-soft: var(--color-{{ color }}-soft);"
                >
                  <span class="story__state-count">
                    {{ forloop.index | prepend: '0' | slice: -2, 2 }}
                    <span class="story__state-total">/ {{ chapters.size | prepend: '0' | slice: -2, 2 }}</span>
                  </span>
                  <span
                    class="story__stat"
                    {% if block.settings.count_to > 0 %}
                      data-count="{{ block.settings.count_to }}"
                    {% endif %}
                  >
                    {{- block.settings.stat -}}
                  </span>
                  <span class="story__caption">{{ block.settings.caption }}</span>
                </div>
              {%- endfor -%}
            </div>

            <ol
              class="story__progress"
              role="list"
            >
              {%- for block in chapters -%}
                {%- assign color = chapter_colors[forloop.index0] -%}
                <li
                  class="story__progress-dot{% if forloop.first %} is-active{% endif %}"
                  data-progress-dot
                  style="--chapter-color: var(--color-{{ color }});"
                ></li>
              {%- endfor -%}
            </ol>
          </div>
        </div>

        <div class="story__texts">
          {%- for block in chapters -%}
            {%- assign color = chapter_colors[forloop.index0] -%}
            <article
              class="story__chapter{% if forloop.first %} is-active{% endif %}"
              data-chapter
              style="--chapter-color: var(--color-{{ color }}); --chapter-soft: var(--color-{{ color }}-soft);"
              {{ block.shopify_attributes }}
            >
              <p class="story__chapter-label text-eyebrow">
                <span class="story__chapter-mark"></span>
                {{ block.settings.label }}
              </p>

              {%- comment -%} Mobile shows the statement inline, since the sticky card is desktop only. {%- endcomment -%}
              <p
                class="story__chapter-stat"
                aria-hidden="true"
              >
                <span
                  {% if block.settings.count_to > 0 %}
                    data-count="{{ block.settings.count_to }}"
                  {% endif %}
                >
                  {{- block.settings.stat -}}
                </span>
                <small>{{ block.settings.caption }}</small>
              </p>

              {%- if block.settings.title != blank -%}
                <h2 class="story__chapter-title h4">{{ block.settings.title }}</h2>
              {%- endif -%}
              <div class="story__chapter-text text-lead">{{ block.settings.text }}</div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- Pull quote ---------- {%- endcomment -%}
  {%- if s.quote != blank -%}
    <figure class="story__quote">
      <div class="story__container">
        <blockquote
          class="story__quote-text"
          data-ink
        >
          {%- assign quote_words = s.quote | split: ' ' -%}
          {%- for word in quote_words -%}
            {%- assign clean = word | remove: ',' | remove: '.' | downcase -%}
            {%- assign accent_word = s.quote_accent | downcase -%}
            <span class="story__ink{% if clean == accent_word %} text-accent story__accent{% endif %}">{{ word }}</span>
            {{- ' ' -}}
          {%- endfor -%}
        </blockquote>
        {%- if s.quote_caption != blank -%}
          <figcaption class="story__quote-caption text-note">{{ s.quote_caption }}</figcaption>
        {%- endif -%}
      </div>
    </figure>
  {%- endif -%}

  {%- comment -%} ---------- Photo ---------- {%- endcomment -%}
  <div class="story__photo-wrap">
    <div class="story__container">
      <figure class="story__photo">
        <div
          class="story__photo-frame"
          data-photo
        >
          {%- if s.image != blank -%}
            {{
              s.image
              | image_url: width: 2400
              | image_tag:
                class: 'story__photo-image',
                widths: '640, 960, 1280, 1600, 2000, 2400',
                sizes: '(min-width: 1400px) 1320px, calc(100vw - 32px)',
                loading: 'lazy',
                alt: s.image.alt
            }}
          {%- else -%}
            <div class="story__photo-placeholder">
              <div class="story__photo-image story__photo-books">
                {%- assign placeholder_designs = 'sunshine,moon,tree' | split: ',' -%}
                {%- for design in placeholder_designs -%}
                  <span class="story__photo-book story__photo-book--{{ forloop.index }}">
                    {%- render 'placeholder-book-cover', design: design -%}
                  </span>
                {%- endfor -%}
              </div>
              <span class="story__photo-hint text-small">Add a family photo in the theme editor</span>
            </div>
          {%- endif -%}
        </div>
        {%- if s.image_caption != blank -%}
          <figcaption class="story__photo-caption text-note">{{ s.image_caption }}</figcaption>
        {%- endif -%}
      </figure>

      {%- if s.button_label != blank -%}
        <div class="story__cta">
          {% render 'brand-button', label: s.button_label, url: s.button_url, style: 'primary', arrow: true %}
        </div>
      {%- endif -%}
    </div>
  </div>
</our-story>

{% stylesheet %}
  .story {
    display: block;
    color: var(--color-ink);
  }

  .story__container {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  /* ---------- Opening ---------- */

  .story__intro {
    padding-block: var(--space-8) var(--space-8);
    text-align: center;
  }

  .story__intro .story__container {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
  }

  .story__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    color: var(--color-ink-muted);
  }

  .story__eyebrow::before {
    content: '';
    width: 8px;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: var(--color-grape);
  }

  .story__headline {
    max-width: 18ch;
    margin: 0;
    font-size: clamp(2.25rem, 1.4rem + 3.6vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  /* Each word sits in a clipping box so it can rise into view. */
  .story__word {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
    vertical-align: top;
  }

  .story__word > span {
    display: inline-block;
  }

  .story__accent {
    color: var(--color-grape);
  }

  .story__lede {
    max-width: 36rem;
    margin: 0;
    color: var(--color-ink-muted);
  }

  .story__scroll-cue {
    display: flex;
    gap: 6px;
    margin-top: var(--space-5);
  }

  .story__dot {
    width: 9px;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    animation: story-bob 1.8s ease-in-out infinite;
  }

  .story__dot--tomato {
    background: var(--color-tomato);
  }

  .story__dot--sun {
    background: var(--color-sun);
    animation-delay: 0.15s;
  }

  .story__dot--sky {
    background: var(--color-sky);
    animation-delay: 0.3s;
  }

  @keyframes story-bob {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(6px);
    }
  }

  /* ---------- Chapters ---------- */

  .story__chapters {
    padding-block: var(--space-6) var(--space-9);
  }

  .story__chapters-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: clamp(var(--space-6), 6vw, var(--space-9));
  }

  .story__panel {
    position: relative;
  }

  .story__card {
    position: sticky;
    top: calc(var(--sticky-header-offset, 0px) + 12vh);
    display: grid;
    /* The colour bar is absolutely placed, so the grid rows are the states and the dots. */
    grid-template-rows: 1fr auto;
    gap: var(--space-5);
    min-height: 420px;
    padding: var(--space-7) var(--space-6) var(--space-6);
    overflow: hidden;
    background: var(--color-paper-deep);
    border: var(--stroke-sm) solid var(--color-line);
    border-radius: var(--radius-lg);
  }

  .story__bar {
    position: absolute;
    inset: 0 0 auto;
    height: var(--colour-bar-thickness);
    background: rgb(var(--color-ink-rgb) / 0.06);
  }

  .story__bar-fill {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      var(--color-sky) 0 25%,
      var(--color-sun) 25% 50%,
      var(--color-leaf) 50% 75%,
      var(--color-grape) 75% 100%
    );
    transform: scaleX(var(--story-progress, 1));
    transform-origin: left;
  }

  .story__states {
    position: relative;
    display: grid;
    align-items: center;
  }

  .story__state {
    grid-area: 1 / 1;
    display: grid;
    gap: var(--space-3);
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms ease, visibility 0s linear 300ms;
  }

  .story__state.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 300ms ease;
  }

  .story__state-count {
    font-family: var(--font-body--family);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-ink);
  }

  .story__state-total {
    color: var(--color-ink-muted);
  }

  .story__stat {
    font-family: var(--font-heading--family);
    font-size: clamp(2.75rem, 1.6rem + 3vw, 4.75rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  /* A soft disc in the chapter's colour behind the statement. */
  .story__state::before {
    content: '';
    position: absolute;
    right: -12%;
    top: 50%;
    z-index: -1;
    width: 62%;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: var(--chapter-soft);
    transform: translateY(-50%);
  }

  .story__caption {
    max-width: 22ch;
    font-family: var(--font-note--family, var(--font-heading--family));
    font-size: 21px;
    font-style: italic;
    line-height: 1.3;
    color: var(--color-ink-muted);
  }

  .story__progress {
    display: flex;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .story__progress-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: rgb(var(--color-ink-rgb) / 0.15);
    transition: width 300ms ease, background-color 300ms ease;
  }

  .story__progress-dot.is-active {
    width: 28px;
    background: var(--chapter-color);
  }

  .story__texts {
    display: grid;
  }

  .story__chapter {
    display: grid;
    align-content: center;
    gap: var(--space-4);
    min-height: 70vh;
    padding-block: var(--space-7);
    opacity: 0.32;
    transition: opacity 400ms ease;
  }

  .story__chapter.is-active {
    opacity: 1;
  }

  .story__chapter-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0;
    color: var(--color-ink-muted);
  }

  .story__chapter-mark {
    width: 26px;
    height: 4px;
    border-radius: var(--radius-full);
    background: var(--chapter-color);
  }

  .story__chapter-stat {
    display: none;
  }

  .story__chapter-title {
    margin: 0;
  }

  .story__chapter-text {
    color: var(--color-ink);
  }

  .story__chapter-text p {
    margin: 0 0 var(--space-4);
  }

  .story__chapter-text p:last-child {
    margin-bottom: 0;
  }

  /* ---------- Quote ---------- */

  .story__quote {
    margin: 0;
    padding-block: var(--space-8);
    background: var(--color-paper-deep);
  }

  .story__quote .story__container {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .story__quote-text {
    max-width: 22ch;
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .story__ink {
    color: var(--color-ink);
  }

  .story__quote-caption {
    margin: 0;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  /* ---------- Photo ---------- */

  .story__photo-wrap {
    padding-block: var(--space-8) var(--space-9);
  }

  .story__photo {
    margin: 0;
  }

  /* Colour-bar frame (signature element). */
  .story__photo-frame {
    overflow: hidden;
    border-style: solid;
    border-width: var(--colour-bar-thickness);
    border-color: var(--color-sky) var(--color-grape) var(--color-tomato) var(--color-sun);
    border-radius: var(--radius-xl);
    background: var(--color-paper-deep);
  }

  .story__photo-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-image);
  }

  .story__photo-placeholder {
    position: relative;
  }

  /* Until a photo is uploaded: the three stand-in covers fanned on paper-deep. */
  .story__photo-books {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    background: var(--color-sky-soft);
  }

  .story__photo-book {
    width: clamp(110px, 16vw, 230px);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--radius-image);
    box-shadow: var(--shadow-book);
  }

  .story__photo-book--1 {
    transform: translateX(12%) rotate(-7deg);
  }

  .story__photo-book--2 {
    z-index: 1;
    transform: translateY(-6%);
  }

  .story__photo-book--3 {
    transform: translateX(-12%) rotate(7deg);
  }

  .story__photo-hint {
    position: absolute;
    left: 50%;
    bottom: var(--space-5);
    padding: var(--space-2) var(--space-4);
    color: var(--color-ink-muted);
    background: var(--color-paper);
    border-radius: var(--radius-full);
    transform: translateX(-50%);
  }

  .story__photo-caption {
    margin-top: var(--space-4);
    text-align: center;
    font-style: italic;
    color: var(--color-ink-muted);
  }

  .story__cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-7);
  }

  /* ---------- Initial states while motion is on (revealed by our-story.js) ---------- */

  .story-motion .story__word > span {
    transform: translateY(105%);
  }

  .story-motion .story [data-intro] {
    opacity: 0;
  }

  .story-motion .story__ink {
    color: rgb(var(--color-ink-rgb) / 0.18);
  }

  .story-motion .story__ink.story__accent {
    color: rgb(var(--color-grape-rgb, 90 74 140) / 0.25);
  }

  /* ---------- Mobile: no sticky card, statements inline ---------- */

  @media screen and (max-width: 989px) {
    .story__intro {
      padding-block: var(--space-7);
    }

    .story__chapters {
      padding-block: 0 var(--space-7);
    }

    .story__chapters-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .story__panel {
      display: none;
    }

    .story__chapter {
      min-height: 0;
      padding-block: var(--space-6);
      border-top: var(--stroke-sm) solid var(--color-line);
      opacity: 1;
    }

    .story__chapter-stat {
      display: grid;
      gap: var(--space-1);
      margin: 0;
      padding: var(--space-5);
      background: var(--chapter-soft);
      border-radius: var(--radius-md);
    }

    .story__chapter-stat span {
      font-family: var(--font-heading--family);
      font-size: 40px;
      font-weight: 600;
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .story__chapter-stat small {
      font-family: var(--font-heading--family);
      font-size: 17px;
      font-style: italic;
      color: var(--color-ink-muted);
    }

    .story__quote {
      padding-block: var(--space-7);
    }

    .story__photo-wrap {
      padding-block: var(--space-7);
    }

    .story__photo-frame {
      border-width: calc(var(--colour-bar-thickness) * 0.7);
      border-radius: var(--radius-lg);
    }

    .story__photo-image {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .story__dot {
      animation: none;
    }

    .story__state,
    .story__chapter,
    .story__progress-dot {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our story",
  "tag": "section",
  "class": "our-story-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Opening"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "textarea",
      "id": "headline",
      "label": "Headline",
      "default": "A pediatrician, an engineer, and a four-year-old who wanted to"
    },
    {
      "type": "text",
      "id": "headline_accent",
      "label": "Heartfelt word at the end, in italics",
      "default": "read"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Short intro under the headline"
    },
    {
      "type": "header",
      "content": "Pull quote"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "A calm page and fifteen patient minutes a day beat every app ever made."
    },
    {
      "type": "text",
      "id": "quote_accent",
      "label": "Word in the quote set in italics",
      "default": "calm"
    },
    {
      "type": "text",
      "id": "quote_caption",
      "label": "Quote caption",
      "default": "what we still believe"
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Caption"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the program"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "chapter",
      "name": "Chapter",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Chapter"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
