{%- comment -%}
  Author page: /pages/author/<handle>, the web page of an Author metaobject
  (templates/metaobject/author.json, METAFIELDS.md).

  A header with the portrait on a sun ring, the name and the bio, then every book whose
  custom.author is this author (snippets/book-shelf.liquid), in a grid.
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign author = metaobject
  assign author_name = author.name.value | default: author.system.handle
  assign photo = author.photo.value

  capture shelf
    render 'book-shelf', source: 'author', value: author, limit: 250, grid: true
  endcapture
-%}

<div class="author-page surface-{{ s.surface }}">
  <div class="author-page__container">
    {%- if s.show_breadcrumbs -%}
      <nav
        class="author-page__breadcrumbs text-small"
        aria-label="Breadcrumb"
      >
        <ol role="list">
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
          <li aria-current="page">{{ author_name }}</li>
        </ol>
      </nav>
    {%- endif -%}

    <header class="author-page__header">
      <div class="author-page__portrait">
        {%- if photo != blank -%}
          {%- assign photo_image = photo.preview_image | default: photo -%}
          {{-
            photo_image
            | image_url: width: 720
            | image_tag:
              class: 'author-page__photo',
              widths: '240, 360, 480, 720',
              sizes: '(min-width: 750px) 280px, 180px',
              fetchpriority: 'high',
              alt: author_name
          -}}
        {%- else -%}
          <span
            class="author-page__initial"
            aria-hidden="true"
            >{{ author_name | slice: 0 }}</span
          >
        {%- endif -%}
      </div>

      <div class="author-page__intro">
        {%- if s.eyebrow != blank -%}
          <p class="author-page__eyebrow text-eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        <h1 class="author-page__name text-display">{{ author_name }}</h1>
        {%- if author.bio.value != blank -%}
          <p class="author-page__bio text-lead">{{ author.bio.value | newline_to_br }}</p>
        {%- endif -%}
      </div>
    </header>

    <section
      class="author-page__books"
      aria-labelledby="AuthorBooks-{{ section.id }}"
    >
      <h2
        id="AuthorBooks-{{ section.id }}"
        class="author-page__books-heading h4"
      >
        {{- s.books_heading | replace: '[author]', author_name -}}
      </h2>
      {%- if shelf != blank -%}
        {{ shelf }}
      {%- else -%}
        <p class="author-page__empty">{{ s.empty_text }}</p>
      {%- endif -%}
    </section>
  </div>
</div>

{% stylesheet %}
  .author-page {
    padding-block: var(--space-4) var(--space-9);
  }

  .author-page__container {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }

  .author-page__breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
    color: var(--color-ink-muted);
  }

  .author-page__breadcrumbs li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--color-line-strong);
  }

  .author-page__breadcrumbs a {
    color: inherit;
    text-decoration: none;
  }

  .author-page__breadcrumbs a:hover {
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .author-page__breadcrumbs [aria-current] {
    color: var(--color-ink);
  }

  .author-page__header {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: center;
    margin-bottom: var(--space-8);
  }

  .author-page__portrait {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .author-page__portrait::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-full);
    background: var(--color-sun);
    transform: translate(12px, 12px);
  }

  .author-page__photo,
  .author-page__initial {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-full);
  }

  .author-page__initial {
    display: grid;
    place-items: center;
    font-family: var(--font-heading--family);
    font-size: 112px;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-sky-soft);
  }

  .author-page__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
    color: var(--color-ink-muted);
  }

  .author-page__eyebrow::before {
    content: '';
    flex: none;
    width: 8px;
    aspect-ratio: 1;
    border-radius: var(--radius-full);
    background: var(--color-sun);
  }

  .author-page__name {
    margin: 0;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .author-page__bio {
    max-width: 40rem;
    margin: var(--space-5) 0 0;
    color: var(--color-ink-muted);
  }

  .author-page__books {
    padding-top: var(--space-7);
    border-top: var(--stroke-sm) solid var(--color-line);
  }

  .author-page__books-heading {
    margin: 0 0 var(--space-6);
    color: var(--color-ink);
  }

  .author-page__empty {
    color: var(--color-ink-muted);
  }

  @media screen and (max-width: 749px) {
    .author-page {
      padding-bottom: var(--space-8);
    }

    .author-page__breadcrumbs {
      display: none;
    }

    .author-page__header {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
      gap: var(--space-6);
      margin-bottom: var(--space-7);
    }

    .author-page__portrait {
      width: 180px;
    }

    .author-page__initial {
      font-size: 72px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Author page",
  "tag": "section",
  "class": "author-page-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Author"
    },
    {
      "type": "text",
      "id": "books_heading",
      "label": "Books heading",
      "info": "[author] is replaced with the author's name.",
      "default": "Books by [author]"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when there are no books",
      "default": "New books by this author are on their way."
    },
    {
      "type": "select",
      "id": "surface",
      "label": "Background",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "paper-deep", "label": "Paper deep" }
      ],
      "default": "paper"
    }
  ],
  "presets": [
    {
      "name": "Author page"
    }
  ]
}
{% endschema %}
